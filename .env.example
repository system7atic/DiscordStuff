# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ERROR_CHANNEL_ID=

# Jobs: comma-separated list of job names to run. Empty = nothing runs.
ENABLED_JOBS=cineplex
JOB_INTERVAL_SECONDS=3600

# Database (matches the db service in docker-compose.yml)
DATABASE_URL=postgresql://discordstuff:discordstuff@db:5432/discordstuff

# Cineplex job — see README for how to find these
CINEPLEX_API_KEY=
CINEPLEX_THEATRE_ID=
CINEPLEX_CITY=
CINEPLEX_REGION=
CINEPLEX_REGION_CODE=
CINEPLEX_POSTAL_CODE=
CINEPLEX_LATITUDE=
CINEPLEX_LONGITUDE=
